{
  "name": "dsh-phanthy-connect",
  "version": "1.4.0",
  "description": "把 PhanthyCode 的模型接进 DeepSeek Harness：插件内 PKCE 登录、按安装证明协议直连上游，不需要桌面端常驻",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "phanthy",
    "phanthycode",
    "llm-provider",
    "anthropic-messages",
    "oauth-pkce"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run build",
    "test": "node test/offline.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "react": "^18.2.0"
  }
}
